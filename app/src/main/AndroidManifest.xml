<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature android:name="android.hardware.type.automotive" android:required="true" />

    <!-- Pleos Vehicle SDK: read -->
    <uses-permission android:name="pleos.car.permission.CAR_DRIVE" />
    <uses-permission android:name="pleos.car.permission.CAR_SEATS" />
    <uses-permission android:name="pleos.car.permission.CAR_CLIMATE" />
    <uses-permission android:name="pleos.car.permission.CAR_LIGHTS" />
    <!-- Pleos Vehicle SDK: control (requires App Market pre-approval) -->
    <uses-permission android:name="pleos.car.permission.CONTROL_CAR_CLIMATE" />
    <uses-permission android:name="pleos.car.permission.CONTROL_CAR_SEATS" />
    <uses-permission android:name="pleos.car.permission.CONTROL_CAR_LIGHTS" />
    <!-- Pleos NaviHelper: turn-by-turn, caution points, route option -->
    <uses-permission android:name="pleos.car.permission.NAVI_ROUTE" />
    <uses-permission android:name="pleos.car.permission.NAVI_ROUTE_SEARCH" />
    <uses-permission android:name="pleos.car.permission.NAVI_CUSTOM_MAP" />
    <!-- AAOS standard data (speed) and driving restrictions -->
    <uses-permission android:name="android.car.permission.CAR_SPEED" />
    <!-- Keeps route requests running while the navigation app is in front (Android 14 freezer) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <application
        android:label="@string/app_name"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar">

        <!-- This app does not support the CCP rotary controller yet -->
        <meta-data android:name="com.hmg.rotary.ROTARY_SUPPORTED" android:value="false" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:resizeableActivity="true"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden">
            <!-- Split screen with the navigation resizes the window: keep the running trip
                 (demo drive, risk, coaching) instead of recreating the activity. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Gleo AI voice actions (see assets/schema.json) -->
            <intent-filter>
                <action android:name="START_MOTION_SICKNESS_RELIEF" />
                <action android:name="STOP_MOTION_SICKNESS_RELIEF" />
                <action android:name="REQUEST_COMFORTABLE_ROUTE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <!-- Allowed while driving; the app applies CarUxRestrictions itself -->
            <meta-data android:name="distractionOptimized" android:value="true" />
        </activity>
        <service
            android:name=".NaviTaskService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Waits for the in-car navigation to finish a route request the user started" />
        </service>
    </application>
</manifest>
